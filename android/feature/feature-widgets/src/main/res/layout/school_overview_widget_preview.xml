<?xml version="1.0" encoding="utf-8"?>
<!--
  The card shown in the launcher's widget picker. It is a still of the real thing rather than a logo
  on a background: the picker is where someone decides whether the widget is worth a home-screen
  slot, and a wordmark tells them nothing about what they would be getting.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_preview_container"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/school_overview_widget_title"
        android:textColor="@color/widget_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/school_overview_widget_preview_sync"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="@drawable/widget_preview_pill">

      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_refresh"
        android:tint="@color/widget_on_accent_container" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/widget_preview_card"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingTop="9dp"
      android:paddingEnd="12dp"
      android:paddingBottom="9dp">

      <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/widget_preview_tile_homework">

        <ImageView
          android:layout_width="17dp"
          android:layout_height="17dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/ic_widget_homework"
          android:tint="@color/widget_content_homework" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:text="@string/school_overview_widget_preview_homework"
          android:textColor="@color/widget_on_surface"
          android:textSize="15sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:text="@string/school_overview_widget_preview_homework_subject"
          android:textColor="@color/widget_on_surface_variant"
          android:textSize="12sp" />
      </LinearLayout>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:text="@string/school_overview_widget_preview_tomorrow"
        android:textColor="@color/widget_content_homework"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginStart="52dp"
      android:background="@color/widget_hairline" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingTop="9dp"
      android:paddingEnd="12dp"
      android:paddingBottom="9dp">

      <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/widget_preview_tile_assessment">

        <ImageView
          android:layout_width="17dp"
          android:layout_height="17dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/ic_widget_assessment"
          android:tint="@color/widget_content_assessment" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:text="@string/school_overview_widget_preview_assessment"
          android:textColor="@color/widget_on_surface"
          android:textSize="15sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:text="@string/school_overview_widget_preview_assessment_subject"
          android:textColor="@color/widget_on_surface_variant"
          android:textSize="12sp" />
      </LinearLayout>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:text="@string/school_overview_widget_preview_date"
        android:textColor="@color/widget_content_assessment"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:background="@drawable/widget_preview_pill"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingTop="9dp"
      android:paddingEnd="12dp"
      android:paddingBottom="9dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/school_overview_widget_preview_grade_count"
        android:textColor="@color/widget_on_accent_container"
        android:textSize="17sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:text="@string/school_overview_widget_grades"
        android:textColor="@color/widget_on_accent_container"
        android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/widget_preview_pill_secondary"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingTop="9dp"
      android:paddingEnd="12dp"
      android:paddingBottom="9dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/school_overview_widget_preview_board_count"
        android:textColor="@color/widget_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:text="@string/school_overview_widget_board"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
