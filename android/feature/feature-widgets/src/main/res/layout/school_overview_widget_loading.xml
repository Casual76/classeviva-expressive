<?xml version="1.0" encoding="utf-8"?>
<!-- What the host shows between placing the widget and the first Glance frame. Deliberately only
     the header: a skeleton of rows that never matches what arrives is worse than a quiet card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_preview_container"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:text="@string/school_overview_widget_title"
    android:textColor="@color/widget_on_surface"
    android:textSize="17sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:maxLines="1"
    android:text="@string/school_overview_widget_loading"
    android:textColor="@color/widget_on_surface_variant"
    android:textSize="12sp" />
</LinearLayout>
