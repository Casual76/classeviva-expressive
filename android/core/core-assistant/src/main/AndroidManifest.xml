<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Una domanda lunga continua anche se l'app viene chiusa: il service in primo piano la porta
       a termine e la notifica di avanzamento diventa la risposta. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <application>
    <service
      android:name=".service.AssistantForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!-- I tool del registro per PampAI/Aria. Niente `android:permission` (engine 3.0): a ogni
         chiamata il provider controlla che chi chiama sia firmato con la stessa chiave
         (`isCallerTrusted`). L'authority segue l'applicationId. -->
    <provider
      android:name=".pampai.RegistroToolHostProvider"
      android:authorities="${applicationId}.ai.tools"
      android:exported="true"
      android:grantUriPermissions="true">
      <meta-data
        android:name="dev.antigravity.fluidengine.ai.TOOL_HOST"
        android:value="1" />
    </provider>
  </application>
</manifest>
